# Already applied to the `resume` repo's release.yml (runs on push to main,
# after the PDF is compiled). Kept here as reference for future workflow
# changes.

      - name: Assemble resume site bundle
        run: |
          mkdir -p dist-resume
          cp site/about/resume/index.html dist-resume/
          cp out/saipraveenos-resume.pdf dist-resume/
          cp site/_headers dist-resume/

      - name: Upload resume site artifact
        uses: actions/upload-artifact@v5
        with:
          name: resume-dist
          path: dist-resume
          if-no-files-found: error
          retention-days: 30

      - name: Notify oruganti-dev-main to redeploy
        uses: peter-evans/repository-dispatch@v3
        with:
          token: ${{ secrets.DISPATCH_TOKEN }}
          repository: saipraveen/oruganti-dev-main
          event-type: resume-updated
